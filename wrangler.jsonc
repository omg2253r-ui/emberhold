// Emberhold on Cloudflare Workers. Build command: tar -xzf emberhold-game.tar.gz && node tools/build-site.mjs
// Deploy command: npx wrangler deploy  (the D1 database "emberhold-db" is created on the first deploy)
{
  "name": "emberhold",
  "main": "cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "emberhold-db" }],
  "observability": { "enabled": true }
}
